{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "node_modules/.tmp/node.tsbuildinfo",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vite/client"],
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "node_modules/.tmp/node"
  },
  "include": ["vite.config.ts", "vitest.config.ts", "scripts", "tests", "src/engine", "src/server/bots.ts", "src/client/tik/lines.ts"]
}
